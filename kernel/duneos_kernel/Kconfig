menu "DuneOS kernel drivers"

config DUNEOS_DRV_NULL
    bool "null/zero character devices (/dev/null, /dev/zero)"
    default y
    help
        Enable /dev/null (write sink, read returns EOF) and /dev/zero
        (read returns infinite zeroes). Always safe to enable.

config DUNEOS_DRV_UART
    bool "UART0 serial device (/dev/uart0)"
    default y
    help
        Enable /dev/uart0 backed by the UART port defined in board_config.h.
        Installs the ESP-IDF UART driver and routes stdout through it.

config DUNEOS_DRV_KLOG
    bool "Kernel log reader (/dev/klog)"
    default y
    help
        Enable /dev/klog. Read-only device; each open() starts replaying
        from the oldest byte still in the kernel ring buffer.

config DUNEOS_DRV_GPIO
    bool "GPIO chip (/dev/gpiochip0)"
    default n
    help
        Enable /dev/gpiochip0 for native ESP32 GPIO access via ioctl().
        Uses esp_driver_gpio (gpio_config, gpio_get/set_level, gpio_set_pull_mode).

config DUNEOS_DRV_I2C
    bool "I2C master bus (/dev/i2c-0)"
    default n
    help
        Enable /dev/i2c-0 as a raw I2C master bus.
        Apps set the target address with ioctl(I2C_SET_ADDR) then call
        write()/read() or ioctl(I2C_RDWR) for combined write-then-read
        transactions. Uses the ESP-IDF v5 i2c_master API.

config DUNEOS_DRV_BATTERY_ADC_SIMPLE
    bool "Battery monitor — ADC voltage divider backend (/dev/battery0)"
    default n
    help
        Enable /dev/battery0 using a resistor-divided VBAT on an ADC pin.
        Board must define DUNEOS_BATTERY_ADC_UNIT, DUNEOS_BATTERY_ADC_CHANNEL,
        DUNEOS_BATTERY_VDIV_FACTOR, DUNEOS_BATTERY_FULL_MV, DUNEOS_BATTERY_EMPTY_MV
        in board_config.h. Suitable for M5Stack CardPuter (VBAT/2 on GPIO10).

config DUNEOS_DRV_SPI
    bool "SPI master bus (/dev/spi-1)"
    default n
    help
        Enable /dev/spi-1 as a raw SPI master bus (SPI3_HOST).
        Apps configure CS/mode/speed via ioctl() then use write()/read() for
        transmit-only/receive-only, or ioctl(SPI_TRANSFER) for full-duplex.
        Board must define DUNEOS_SPI1_HOST, DUNEOS_SPI1_MOSI_PIN,
        DUNEOS_SPI1_MISO_PIN, and DUNEOS_SPI1_CLK_PIN in board_config.h.
        Not available on boards where SPI3 is already used by the display.

config DUNEOS_DRV_INPUT
    bool "Input event device (/dev/input/event0)"
    default n
    help
        Enable /dev/input/event0. read() blocks until at least one
        input_event_t is available, then returns one or more events.
        This option only provides the ring buffer and VFS device node.
        At least one backend (DUNEOS_DRV_INPUT_IOMATRIX, …) must also
        be enabled to produce events.

config DUNEOS_DRV_INPUT_IOMATRIX
    bool "Input backend — IOMatrix keyboard (M5Stack CardPuter)"
    default n
    depends on DUNEOS_DRV_INPUT
    help
        Enable the IOMatrix keyboard scanner for boards that wire a 74HC138
        row decoder + GPIO column inputs directly to the ESP32.
        Board must define DUNEOS_KB_ROW_A0/A1/A2_PIN, DUNEOS_KB_COL_PINS,
        DUNEOS_KB_NUM_COLS, DUNEOS_KB_MATRIX_ROWS, DUNEOS_KB_MATRIX_COLS
        in board_config.h.  Runs a FreeRTOS scan task at ~100 Hz.

config DUNEOS_DRV_INPUT_BTNGPIO
    bool "Input backend — simple GPIO buttons"
    default n
    depends on DUNEOS_DRV_INPUT
    help
        Enable polling for simple active-LOW GPIO buttons.
        Board must define DUNEOS_HAVE_BTN_GPIO, DUNEOS_BTN_GPIO_COUNT,
        DUNEOS_BTN_GPIO_PINS and DUNEOS_BTN_GPIO_CODES in board_config.h.
        Each button emits INPUT_EV_KEY press/release events.
        10 ms poll period provides contact debounce.

config DUNEOS_DRV_INPUT_ENCODER
    bool "Input backend — quadrature rotary encoder"
    default n
    depends on DUNEOS_DRV_INPUT
    help
        Enable quadrature decoding for a rotary encoder.
        Board must define DUNEOS_HAVE_ENCODER, DUNEOS_ENCODER_A_PIN and
        DUNEOS_ENCODER_B_PIN in board_config.h.
        Emits INPUT_EV_REL / REL_WHEEL events: +1 CW, -1 CCW per detent.
        On Xtensa ESP32-S3: uses hardware PCNT (ISR, zero CPU polling).
        On other architectures: GPIO polling fallback at 500 Hz.

config DUNEOS_DRV_GPIOCHIP_SX1509
    bool "GPIO expander — SX1509 16-pin I2C (/dev/gpiochipN)"
    default n
    depends on DUNEOS_DRV_I2C
    help
        Enable support for SparkFun/Semtech SX1509 I2C GPIO expander.
        Each expander in the board YAML becomes /dev/gpiochip1, /dev/gpiochip2, …
        Board must define DUNEOS_GPIOCHIP1_TYPE, DUNEOS_GPIOCHIP1_I2C_ADDR and
        DUNEOS_GPIOCHIP1_PINS (generated by bspgen from gpio_expanders: YAML).
        Driver stub only — full implementation pending Phase 8 expander support.

config DUNEOS_DRV_GPIOCHIP_PCF8574
    bool "GPIO expander — PCF8574 8-pin I2C (/dev/gpiochipN)"
    default n
    depends on DUNEOS_DRV_I2C
    help
        Enable support for Texas Instruments PCF8574 I2C GPIO expander.
        See DUNEOS_DRV_GPIOCHIP_SX1509 for the board_config.h convention.
        Driver stub only — full implementation pending Phase 8 expander support.

config DUNEOS_DRV_GPIOCHIP_MCP23017
    bool "GPIO expander — MCP23017 16-pin I2C (/dev/gpiochipN)"
    default n
    depends on DUNEOS_DRV_I2C
    help
        Enable support for Microchip MCP23017 I2C GPIO expander.
        See DUNEOS_DRV_GPIOCHIP_SX1509 for the board_config.h convention.
        Driver stub only — full implementation pending Phase 8 expander support.

config DUNEOS_DRV_FB
    bool "Framebuffer device (/dev/fb0) — ST7789 kernel driver"
    default n
    depends on SPIRAM
    help
        Enable /dev/fb0 backed by a 16-bit RGB565 back-buffer in PSRAM.
        Only available on boards with external PSRAM (CONFIG_SPIRAM=y).
        Board must define DUNEOS_HAVE_DISPLAY and DUNEOS_DISPLAY_* pin
        constants in board_config.h.
        Apps write host-endian RGB565 pixels via write(); the driver
        byte-swaps during ioctl(FB_FLUSH) DMA to the ST7789 display.
        On non-PSRAM boards, the display is served by userspace libst7789
        via /dev/spi-N (see Phase 24-debt #6+#2 — no kernel driver).

config DUNEOS_DRV_WIFI
    bool "WiFi STA helper functions (duneos_wifi_* ABI symbols)"
    default n
    help
        Export duneos_wifi_init / duneos_wifi_sta_connect /
        duneos_wifi_sta_disconnect / duneos_wifi_get_info /
        duneos_netif_wait_ip to userspace apps.
        All ESP-IDF WiFi / netif / NVS complexity is encapsulated in
        drv_wifi.c; apps only need to include duneos/wifi.h.
        No /dev device node is registered — this driver exposes pure
        function-pointer ABI, not a file interface.
        Enable wifi_daemon.dap to connect at boot via /sd/wifi.conf.

config DUNEOS_DRV_RAW80211
    bool "Raw 802.11 frame injection (/dev/raw80211)"
    default n
    depends on DUNEOS_DRV_WIFI
    help
        Enable /dev/raw80211 for injecting arbitrary IEEE 802.11 frames
        directly via esp_wifi_80211_tx(), bypassing the TCP/IP stack.
        write(fd, frame, len) transmits one frame on the selected interface
        (STA by default; switch to AP via ioctl(RAW80211_SET_IFACE)).
        Requires DUNEOS_PERM_NET_RAW in the app manifest.
        Requires WiFi to be initialised (wifi_daemon running, or
        duneos_wifi_init() called before open()).
        Analogous to AF_PACKET / monitor-mode sockets on Linux.

config DUNEOS_DRV_USB_MSC
    bool "USB Mass Storage device — expose SD card (/sd) to host"
    default n
    help
        Enable USB MSC device using TinyUSB (espressif/esp_tinyusb).
        Exposes the SD card as a removable USB drive.
        When the host holds the storage the SD card is unmounted from /sd;
        it is automatically remounted on host eject.
        Requires an SD card to be inserted at boot.
        NOTE: enabling USB OTG (TinyUSB) and USB-JTAG console simultaneously
        is not supported. Set console: uart in board.yaml when using this option.

config DUNEOS_DRV_USB_CDC
    bool "USB CDC-ACM virtual serial port (/dev/ttyUSB0)"
    default n
    help
        Enable USB CDC-ACM device using TinyUSB (espressif/esp_tinyusb).
        Registers /dev/ttyUSB0 as a standard character device backed by the
        USB virtual serial port. Frees the physical UART for app use.
        The shell can use /dev/ttyUSB0 instead of /dev/uart0 for its console.
        NOTE: same USB-JTAG conflict as DUNEOS_DRV_USB_MSC applies.

endmenu
