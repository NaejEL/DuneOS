# BQ27220 fuel gauge — LilyGO T-Embed (gauge at 0x55)
# Addresses are TI SLUUBD4A table 2-1, the datasheet — NOT copied from
# sdk/sensor/libbq27220.c, which is what this file used to say and which is how
# it came to repeat that file's three wrong registers back as confirmation.
# tools/dbt/tests/test_bq27220_registers.py now checks both against the table.
name BQ27220
addr 0x55
word  0x08 mV Voltage
word  0x2C %  Charge
sword 0x0C mA Current
hex   0x0A -  Flags
