# Generated by `rgkb index`: never merge, never diff. On a conflict, take either
# side and re-run `python .claude/rgkb/rgkb.py index` — the content is derived
# from the tree, so no information lives only here.
index.sqlite  binary -diff -merge
graph.json    -diff -merge text eol=lf
manifest.json -diff -merge text eol=lf
files.jsonl   -diff -merge text eol=lf
symbols.jsonl -diff -merge text eol=lf

# Hand- and agent-written: these are real content, keep them diffable and mergeable.
notes.jsonl text eol=lf
config.json text eol=lf
