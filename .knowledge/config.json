{
  "schema": 1,
  "globs": [],
  "exclude": [
    "!.knowledge/**",
    "!.git/**",
    "!**/node_modules/**",
    "!**/.venv/**",
    "!**/venv/**",
    "!**/__pycache__/**",
    "!**/obj/**",
    "!**/dist/**",
    "!**/build/**",
    "!**/target/**",
    "!**/*.min.js",
    "!**/*.lock",
    "!build-*/**",
    "!managed_components/**",
    "!tools/.dbt-venv/**",
    "!factory-logs/**",
    "!.pytest_cache/**",
    "!third_party/**",
    "!**/*.png",
    "!**/*.jpg",
    "!**/*.jpeg",
    "!**/*.gif",
    "!**/*.ico",
    "!**/*.pdf",
    "!**/*.vcd",
    "!**/*.bin",
    "!**/*.elf",
    "!**/*.dap"
  ],
  "include_hidden": false,
  "max_file_bytes": 1000000,
  "max_names": 5000,
  "max_edges": 20000,
  "min_name_len": 4,
  "rg_path": null,
  "languages": null,
  "hooks": "off"
}
