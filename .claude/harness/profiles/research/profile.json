  "detection": {
    "accept": 5,
    "reject": 2,
    "criteria": [
      {
        "id": "ml-dependency",
        "kind": "dependency",
        "weight": 2,
        "names": [
          "numpy",
          "torch",
          "jax",
          "tensorflow",
          "transformers",
          "scipy"
        ]
      },
      {
        "id": "dated-journal",
        "kind": "content",
        "weight": 3,
        "glob": "docs/*.md",
        "regex": "^## \\d{4}-\\d{2}-\\d{2}"
      },
      {
        "id": "architecture-doc",
        "kind": "glob",
        "weight": 1,
        "pattern": "docs/ARCHITECTURE.md"
      },
      {
        "id": "claude-md-vocabulary",
        "kind": "content",
        "weight": 2,
        "glob": "CLAUDE.md",
        "regex": "(Vocabulaire|État du projet)"
      },
      {
        "id": "eval-dir",
        "kind": "dir",
        "weight": 1,
        "path": "eval"
      },
      {
        "id": "experiments-dir",
        "kind": "dir",
        "weight": 1,
        "path": "experiments"
      },
      {
        "id": "scientific-corpus",
        "kind": "judgement",
        "weight": 2,
        "question": "Is the project a scientific corpus (dated journal, architecture, results table)?"
      },
      {
        "id": "gpu-declared",
        "kind": "judgement",
        "weight": 1,
        "question": "Is GPU hardware declared in the documentation?"
      }
    ]
  },
  "audit_sections": [
    "research"
  ],
  "entry_keywords": [
    "suivant"
  ],
  "params": [
    {
      "name": "stacks",
      "source": "detected",
      "required": false
    },
    {
      "name": "interpreter",
      "source": "detected",
      "required": true
    },
    {
      "name": "test_command",
      "source": "judgement",
      "required": false
    },
    {
      "name": "conventions",
      "source": "judgement",
      "required": false
    },
    {
      "name": "extra_tools",
      "source": "judgement",
      "required": false
    }
  ]
