  "detection": {
    "accept": 3,
    "reject": 2,
    "criteria": [
      {
        "id": "manifest-node",
        "kind": "glob",
        "weight": 2,
        "pattern": "package.json"
      },
      {
        "id": "manifest-dotnet",
        "kind": "glob",
        "weight": 2,
        "pattern": "*.csproj"
      },
      {
        "id": "manifest-go",
        "kind": "glob",
        "weight": 2,
        "pattern": "go.mod"
      },
      {
        "id": "manifest-rust",
        "kind": "glob",
        "weight": 2,
        "pattern": "Cargo.toml"
      },
      {
        "id": "manifest-python-package",
        "kind": "content",
        "weight": 2,
        "glob": "pyproject.toml",
        "regex": "^\\[project\\]"
      },
      {
        "id": "sources",
        "kind": "dir",
        "weight": 1,
        "path": "src"
      },
      {
        "id": "tests",
        "kind": "dir",
        "weight": 1,
        "path": "test"
      },
      {
        "id": "tests-plural",
        "kind": "dir",
        "weight": 1,
        "path": "tests"
      },
      {
        "id": "ci",
        "kind": "glob",
        "weight": 1,
        "pattern": ".github/workflows/*.yml"
      },
      {
        "id": "software-package",
        "kind": "judgement",
        "weight": 2,
        "question": "Does the project contain a real, deliverable software package, distinct from a research corpus?"
      }
    ]
  },
  "audit_sections": [
    "roadmap",
    "attack",
    "detail"
  ],
  "params": [
