# M5Stack CardPuter — ESP32-S3FN8: 8MB embedded flash, NO PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# PSRAM absent on CardPuter — do not enable SPIRAM
CONFIG_SPIRAM=n

# CardPuter console: native USB Serial/JTAG on GPIO19/20
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# DuneOS loads app code into DRAM and executes via the IRAM alias.
# MEMPROT locks the IRAM/DRAM split at _iram_end, making the IRAM alias of
# free DRAM non-executable and the DRAM alias of static IRAM read-only.
# Either way dynamic code loading is impossible with MEMPROT active.
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n

# DuneOS kernel driver selection — generated by duneos-bspgen
CONFIG_DUNEOS_DRV_NULL=y
CONFIG_DUNEOS_DRV_UART=y
CONFIG_DUNEOS_DRV_KLOG=y
CONFIG_DUNEOS_DRV_GPIO=y
CONFIG_DUNEOS_DRV_INPUT=y
CONFIG_DUNEOS_DRV_INPUT_IOMATRIX=y
CONFIG_DUNEOS_DRV_BATTERY_ADC_SIMPLE=y
CONFIG_DUNEOS_DRV_DISP=y
CONFIG_DUNEOS_DRV_WIFI=y
