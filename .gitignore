build/
# Per-board build dirs (dbt qemu: build-esp32s3-qemu, build-esp32s3-qemu-psram),
# each holding its own sdkconfig so two boards don't clobber one another
build-*/

# Per-developer board/port selection
.duneos_board
.duneos_port
.duneos_idf
.duneos_sd
.duneos_profile

sdkconfig
sdkconfig.old
*.lock

# Board-change detection stamp (written by CMakeLists.txt at configure time)
duneos_last_board.stamp

*.pyc
__pycache__/
.vscode/
.devcontainer/

# Software factory (agents, skill, project settings) is shared;
# settings.local.json and everything else in .claude/ stays local
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/settings.json
# rgkb code-index server — shared so the .knowledge/ base is usable after a clone
!.claude/rgkb/
*.swp
*.swo
*.o
*.d

# IDF Component Manager — downloaded deps (like node_modules)
managed_components/

# dbt self-managed virtualenv
tools/.dbt-venv/

# libdune per-arch build cache (regenerated by dbt build)
libdune/build/

# BSP generator artefacts — re-generated from boards/*/board.yaml, never committed
boards/*/board_config.h
boards/*/sdkconfig.board
boards/*/partitions.csv
boards/*/idf_target.txt

# Root partitions.csv superseded by per-board generation
partitions.csv
.clangd

# Phase 25.5: per-board /etc — non-sensitive configs (splash logo path,
# etc.) ARE committed. Apps that hold credentials list themselves below so
# the real config stays local; only the .example template is committed.
boards/*/etc/wifi_daemon/config.yaml
boards/*/etc/wifi/known.yaml

# Logic-analyzer captures dumped by i2cscope (sniffer) — test artifacts
*.vcd

# Software-factory CI run logs
factory-logs/
